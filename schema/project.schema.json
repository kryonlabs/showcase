{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kryonlabs/showcase/schema/project.schema.json",
  "title": "Kryon showcase project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "name", "summary", "author", "repository", "banner", "tags"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 220
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "url", "owner", "name"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["github", "gitlab", "codeberg"]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "banner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://.*\\.(png|jpg|jpeg|webp)$"
        },
        "alt": {
          "type": "string",
          "maxLength": 140
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "maxLength": 32
      }
    },
    "featured": {
      "type": "boolean"
    },
    "unranked": {
      "type": "boolean"
    }
  }
}
